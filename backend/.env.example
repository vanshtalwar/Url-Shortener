PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/url-shortener
JWT_SECRET=<long random string>
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
VISITOR_HASH_SALT=<long random string>
SMTP_USER=<your-gmail-address>         # sends verification / password-reset emails
SMTP_PASS=<gmail-app-password>         # Google account → Security → App passwords (needs 2-Step Verification)
RAZORPAY_KEY_ID=rzp_test_<...>         # Razorpay Dashboard → Account & Settings → API Keys (start in Test mode)
RAZORPAY_KEY_SECRET=<key-secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>   # set when adding the webhook (URL: <backend>/api/billing/webhook)
RAZORPAY_PLAN_MONTHLY=plan_<...>       # Subscriptions → Plans: ₹199 every 1 month
RAZORPAY_PLAN_YEARLY=plan_<...>        # Subscriptions → Plans: ₹1,990 every 1 year

# Optional (defaults shown)
# TRUST_PROXY_HOPS=1          # reverse proxies in front of the app; see README "Client IP behind proxies"
# LOGIN_RATE_LIMIT=10         # per IP per 15 min
# LINK_WRITE_RATE_LIMIT=30    # per user per 15 min
# REDIRECT_RATE_LIMIT=120     # per IP per minute
# UNLOCK_RATE_LIMIT=10        # password guesses per IP per protected link per 15 min

# Country/city analytics (MaxMind GeoLite2, free account). Without these, click locations are "Unknown".
# Used at build time by scripts/download-geoip.sh (runs automatically after `npm run build`).
# MAXMIND_ACCOUNT_ID=<account id>
# MAXMIND_LICENSE_KEY=<license key>
# GEOIP_DB_PATH=data/GeoLite2-City.mmdb
